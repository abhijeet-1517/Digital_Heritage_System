# ==============================================================================
# National Cultural Heritage Management System - Environment Configuration
# Copy this file to .env and configure with your actual Neo4j Aura credentials.
# ==============================================================================

# Database Mode: "neo4j" or "mock"
# When set to "neo4j", the system connects to Neo4j Aura.
# If credentials or connectivity fail in "neo4j" mode, the app fails clearly and does not silently serve mock data.
# When explicitly set to "mock", the system runs with local in-memory storage.
DATABASE_MODE=neo4j

# Neo4j Aura Connection Parameters
NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
